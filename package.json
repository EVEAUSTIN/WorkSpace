{
  "name": "qijian-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "栖间个人工作台",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "test:desktop": "node --test tests/desktop-storage.test.cjs tests/workspace-sync.test.cjs tests/desktop-server.test.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.qijian.workspace",
    "productName": "栖间工作台",
    "directories": {"output": "dist"},
    "files": ["desktop/**", "index.html", "assets/**", "cloudbase-test.html"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false}
  }
}
